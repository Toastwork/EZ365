# ---- Authentification des operateurs -------------------------------------
AUTH_MODE=ldap
LDAP_SERVER=192.168.1.30
LDAP_USE_SSL=false
LDAP_DOMAIN=acskm.fr
LDAP_BASE_DN=DC=acs,DC=local
LDAP_REQUIRED_GROUP=Informatique

# ---- Chiffrement des donnees dans /data ----------------------------------
# Generer avec :
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
STORAGE_KEY=
LOG_LEVEL=INFO

# ---- TLS servi par uvicorn (laisser vide derriere un reverse proxy) -------
SSL_CERTFILE=/certs/vaultwarden.crt
SSL_KEYFILE=/certs/vaultwarden.key
#SSL_KEYFILE_PASSWORD=

# ---- Application Entra ID multi-tenant ------------------------------------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://ez365.acskm.fr:9001/ms/callback

# ---- Coffre Bitwarden (sidecar bw serve) ----------------------------------
VAULT_ENABLED=true
VAULT_API_URL=http://bw-cli:8087

# ---- Sidecar bw-cli --------------------------------------------------------
BW_SERVER=https://vaultwarden.acskm.fr:9000
BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
# Facultatif : repli e-mail + mot de passe maitre si la cle API est refusee.
BW_EMAIL=
